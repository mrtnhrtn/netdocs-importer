<UserControl x:Class="NetDocsImporter.App.Views.Steps.ReviewScopeStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="260" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="4" BorderBrush="#E4E7EB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            MinWidth="420"
                            MaxWidth="760"
                            Visibility="{Binding ShowImportContext, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Source Folder" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Select Folder"
                                Width="120"
                                Margin="0,0,6,0"
                                Click="OnSelectFolder"
                                IsEnabled="{Binding CanSelectSourceFolder}"
                                Style="{StaticResource SecondaryButton}" />
                        <Button Content="Cancel Scan"
                                Width="110"
                                Click="OnCancelScan"
                                IsEnabled="{Binding IsScanning}"
                                Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedFolderPath}" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Margin="0,2,0,0"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left"
                            MaxWidth="520"
                            Visibility="{Binding ShowReviewTargetProfileContext, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                                <Setter Property="Text" Value="NetDocuments Target &amp; Profiling" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExportMode}" Value="True">
                                        <Setter Property="Text" Value="NetDocuments Source Confirmation" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Cabinet:" FontWeight="SemiBold" Foreground="{DynamicResource BodyForegroundBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ReviewTargetCabinetDisplay}" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Target container:" FontWeight="SemiBold" Foreground="{DynamicResource BodyForegroundBrush}" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ReviewWorkspaceNameDisplay}" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Target path:"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BodyForegroundBrush}"
                                   Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExportMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Row="2"
                                   Grid.Column="2"
                                   Text="{Binding ReviewTargetPath}"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExportMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock Text="Profile Attributes (Inherited Defaults)"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BodyForegroundBrush}"
                               Margin="0,0,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExportMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border BorderBrush="#E4E7EB" BorderThickness="1" CornerRadius="4" Padding="6" MinWidth="320" MaxHeight="170">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExportMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <TextBlock Text="No inherited profile attributes available."
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasReviewEffectiveDefaults}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasReviewEffectiveDefaults}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <ItemsControl ItemsSource="{Binding ReviewEffectiveDefaults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding AttributeName}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BodyForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding DisplayValue}"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border BorderBrush="#E4E7EB"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8"
                        Margin="0,0,0,8"
                        Visibility="{Binding ShowImportContext, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Direct Upload" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Refresh Direct Upload Plan"
                                    Width="190"
                                    Margin="0,0,6,0"
                                    Click="OnRefreshDirectUploadPlan"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button Content="Run Direct Upload"
                                    Width="130"
                                    Margin="0,0,6,0"
                                    Click="OnRunDirectUpload"
                                    Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding CanRunDirectUpload}" />
                            <Button Content="Add to Queue"
                                    Width="110"
                                    Margin="0,0,6,0"
                                    Click="OnAddDirectUploadToQueue"
                                    Style="{StaticResource SecondaryButton}"
                                    IsEnabled="{Binding CanAddDirectUploadToQueue}" />
                            <Button Content="Schedule..."
                                    Width="95"
                                    Margin="0,0,6,0"
                                    Click="OnScheduleDirectUpload"
                                    Style="{StaticResource SecondaryButton}"
                                    IsEnabled="{Binding CanScheduleDirectUpload}" />
                            <Button Content="Cancel Upload"
                                    Width="110"
                                    Margin="0,0,6,0"
                                    Click="OnCancelDirectUpload"
                                    Style="{StaticResource SecondaryButton}"
                                    IsEnabled="{Binding CanCancelDirectUpload}" />
                            <Button Content="Open Last CSV"
                                    Width="110"
                                    Click="OnOpenLastDirectUploadReport"
                                    Style="{StaticResource SecondaryButton}"
                                    IsEnabled="{Binding CanOpenLastDirectUploadReport}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                            <ProgressBar Width="280"
                                         Height="12"
                                         Maximum="100"
                                         Value="{Binding DirectUploadProgressPercent, Mode=OneWay}" />
                            <TextBlock Text="{Binding DirectUploadProgressPercentDisplay}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding DirectUploadStatus}" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,6" TextWrapping="Wrap" />
                        <TextBlock Text="Preflight Issues" Foreground="{DynamicResource MutedForegroundBrush}" />
                        <DataGrid ItemsSource="{Binding DirectUploadPreflightIssues}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  Margin="0,4,0,0"
                                  MinHeight="160">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="140" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                                <DataGridTextColumn Header="Relative Path" Binding="{Binding RelativePath}" Width="220" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#E4E7EB"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8"
                        Margin="0,0,0,8"
                        Visibility="{Binding ShowExportContext, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Export" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Margin="0,0,6,0"
                                     Text="{Binding ExportDestinationRootPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Content="Browse"
                                    Click="OnBrowseExportDestination"
                                    Style="{StaticResource SecondaryButton}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox Content="All versions"
                                      IsChecked="{Binding ExportAllVersions}"
                                      Margin="0,0,16,0" />
                            <CheckBox Content="Download filters as folders"
                                      IsChecked="{Binding ExportDownloadFiltersAsFolders}" />
                            <CheckBox Content="Include custom attributes"
                                      IsChecked="{Binding ExportIncludeCustomAttributes}"
                                      Margin="16,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Metadata format:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Width="120"
                                      ItemsSource="{Binding ExportMetadataFormatOptions}"
                                      SelectedItem="{Binding ExportMetadataFormat}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Refresh Export Plan"
                                    Width="170"
                                    Margin="0,0,6,0"
                                    Click="OnRefreshExportPreflight"
                                    IsEnabled="{Binding CanRefreshExportPreflight}"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button Content="Run Export"
                                    Width="110"
                                    Margin="0,0,6,0"
                                    Click="OnRunExport"
                                    IsEnabled="{Binding CanRunExport}"
                                    Style="{StaticResource PrimaryButton}" />
                            <Button Content="Cancel"
                                    Width="90"
                                    Margin="0,0,6,0"
                                    Click="OnCancelExport"
                                    IsEnabled="{Binding CanCancelExport}"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button Content="Open Last Manifest"
                                    Width="150"
                                    Click="OnOpenLastExportManifest"
                                    IsEnabled="{Binding CanOpenLastExportManifest}"
                                    Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                            <ProgressBar Width="280"
                                         Height="12"
                                         Maximum="100"
                                         Value="{Binding ExportProgressPercent, Mode=OneWay}" />
                            <TextBlock Text="{Binding ExportProgressPercentDisplay}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding ExportStatus}" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,4" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ExportSummary}" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,6" TextWrapping="Wrap" />
                        <TextBlock Text="Preflight Issues" Foreground="{DynamicResource MutedForegroundBrush}" />
                        <DataGrid ItemsSource="{Binding ExportPreflightIssues}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  Margin="0,4,0,0"
                                  MinHeight="160">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="180" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                                <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="200" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#E4E7EB" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Profiling Validation" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{Binding ValidationErrorCountDisplay, StringFormat=Errors: {0}}" Foreground="#B42318" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ValidationWarningCountDisplay, StringFormat=Warnings: {0}}" Foreground="#B45309" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ValidationInfoCountDisplay, StringFormat=Info: {0}}" Foreground="{DynamicResource MutedForegroundBrush}" />
                        </StackPanel>
                        <TextBlock Text="Validating..." Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReviewScopeValidationBusy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListView ItemsSource="{Binding ProfilingValidationIssues}" Height="170">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Severity" Width="70" DisplayMemberBinding="{Binding SeverityDisplay}" />
                                    <GridViewColumn Header="Scope" Width="55" DisplayMemberBinding="{Binding ScopeDisplay}" />
                                    <GridViewColumn Header="Target" Width="95" DisplayMemberBinding="{Binding Target}" />
                                    <GridViewColumn Header="Message" Width="250" DisplayMemberBinding="{Binding Message}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </Border>

                <StackPanel Visibility="Collapsed">
                    <TextBlock Text="Details" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding SelectedFolderRelativePath}" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedFolderPath}" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <TextBlock Text="This folder will not be created in NetDocuments via ndImport."
                               Foreground="#B45309"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Visibility="{Binding SelectedFolderIsEffectivelyEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                        <TextBlock Text="{Binding SelectedFolderFilesDisplay, StringFormat=Total files: {0}}" />
                        <TextBlock Text="{Binding SelectedFolderBytesDisplay, StringFormat=Total bytes: {0}}" />
                        <TextBlock Text="{Binding SelectedFolderLargeFilesDisplay, StringFormat=Large files: {0}}" />
                        <TextBlock Text="{Binding SelectedFolderExcludedDisplay, StringFormat=Excluded folders: {0}}" />
                    </StackPanel>

                    <TextBlock Text="Folder selection" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Width="110" Margin="0,0,6,0" Click="OnSetImportInherit" Style="{StaticResource SecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="?" Foreground="#888888" Margin="0,0,6,0" />
                                <TextBlock Text="Inherit" />
                            </StackPanel>
                        </Button>
                        <Button Width="110" Margin="0,0,6,0" Click="OnSetImportInclude" Style="{StaticResource SecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="12" Height="12" Fill="#2E7D32" Data="M2,6 L5,9 L10,2" Stroke="#2E7D32" StrokeThickness="2" Margin="0,0,6,0" />
                                <TextBlock Text="Include" />
                            </StackPanel>
                        </Button>
                        <Button Width="110" Click="OnSetImportExclude" Style="{StaticResource SecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="12" Height="12" Stroke="#C62828" StrokeThickness="2" Data="M2,2 L10,10 M10,2 L2,10" Margin="0,0,6,0" />
                                <TextBlock Text="Exclude" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Content="Apply to children" Width="140" Margin="0,0,0,6" Click="OnApplyImportToChildren" Style="{StaticResource SecondaryButton}" />
                    <TextBlock Text="{Binding SelectedImportMode, StringFormat=Selected mode: {0}}" Foreground="{DynamicResource MutedForegroundBrush}" />
                    <TextBlock Text="{Binding SelectedEffectiveImportMode, StringFormat=Effective mode: {0}}" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,10" />

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
