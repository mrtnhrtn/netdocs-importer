<UserControl x:Class="NetDocsImporter.App.Views.Steps.ReviewScopeStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="260" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="4" BorderBrush="#E4E7EB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Source Folder" Style="{StaticResource SectionTitle}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Select Folder"
                            Width="120"
                            Margin="0,0,6,0"
                            Click="OnSelectFolder"
                            IsEnabled="{Binding CanSelectSourceFolder}"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Content="Cancel Scan"
                            Width="110"
                            Click="OnCancelScan"
                            IsEnabled="{Binding IsScanning}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource SecondaryButton}" />
                </StackPanel>
                <TextBlock Text="{Binding SelectedFolderPath}" Foreground="#555555" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StatusText}" Foreground="#555555" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="0" Visibility="{Binding ShowLegacyScopeExplorer, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Folders" Style="{StaticResource SectionTitle}" />
            <TextBox Text="{Binding TreeSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
            <Border Background="#F8FAFC" BorderBrush="#D9E2EC" BorderThickness="1" CornerRadius="6" Padding="6">
                <TreeView ItemsSource="{Binding FolderRoots}"
                          SelectedItemChanged="OnFolderTreeSelectedItemChanged"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          BorderThickness="0">
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Include" Click="OnSetImportInclude" />
                            <MenuItem Header="Exclude" Click="OnSetImportExclude" />
                            <MenuItem Header="Clear override" Click="OnSetImportInherit" />
                            <Separator />
                            <MenuItem Header="Apply to children" Click="OnApplyImportToChildren" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Padding" Value="4,3" />
                            <Setter Property="Margin" Value="0,1,0,1" />
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnFolderTreeRightButtonDown" />
                            <EventSetter Event="Expanded" Handler="OnFolderTreeExpanded" />
                            <EventSetter Event="Collapsed" Handler="OnFolderTreeCollapsed" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#CFE3FF" />
                                    <Setter Property="BorderBrush" Value="#8BB4FF" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Border>
        </StackPanel>

        <GridSplitter Grid.Row="1" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Visibility="{Binding ShowLegacyScopeExplorer, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Background="#E4E7EB" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

        <StackPanel Grid.Row="1" Grid.Column="2" Margin="8,0,12,0" Visibility="{Binding ShowLegacyScopeExplorer, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Files" Style="{StaticResource SectionTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox Width="220" Text="{Binding FileSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                <Button Content="All" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="OnFilterAll" />
                <Button Content="Included" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="OnFilterIncluded" />
                <Button Content="Excluded" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="OnFilterExcluded" />
                <Button Content="Overrides" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="OnFilterOverrides" />
                <Button Content="Large" Style="{StaticResource SecondaryButton}" Click="OnFilterLarge" />
            </StackPanel>
            <TextBlock Text="No folders found. Run a scan to populate files."
                       Foreground="#6B7280"
                       Margin="0,0,0,8"
                       Visibility="{Binding HasFolderRoots, Converter={StaticResource InverseBooleanConverter}}" />
            <DataGrid x:Name="FolderFilesGrid" ItemsSource="{Binding FolderFiles}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      IsReadOnly="True" GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#CCD0D5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
                    <DataGridTextColumn Header="Relative Path" Binding="{Binding RelativePath}" Width="*" />
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="90" />
                    <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedDisplay}" Width="140" />
                    <DataGridTextColumn Header="Large" Binding="{Binding LargeWarning}" Width="70" />
                    <DataGridTextColumn Header="Import" Binding="{Binding EffectiveImport}" Width="70" />
                    <DataGridTextColumn Header="Override" Binding="{Binding OverrideMode}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border BorderBrush="#E4E7EB" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="NetDocuments Target &amp; Profiling" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding ReviewTargetBreadcrumbDisplay}" Foreground="#555555" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border BorderBrush="#E4E7EB" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Direct Upload" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Refresh Direct Upload Plan"
                                    Width="190"
                                    Margin="0,0,6,0"
                                    Click="OnRefreshDirectUploadPlan"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button Content="Run Direct Upload"
                                    Width="130"
                                    Click="OnRunDirectUpload"
                                    Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding CanRunDirectUpload}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                            <ProgressBar Width="280"
                                         Height="12"
                                         Maximum="100"
                                         Value="{Binding DirectUploadProgressPercent}" />
                            <TextBlock Text="{Binding DirectUploadProgressPercentDisplay}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding DirectUploadStatus}" Foreground="#555555" Margin="0,0,0,6" TextWrapping="Wrap" />
                        <TextBlock Text="Preflight Issues" Foreground="#555555" />
                        <DataGrid ItemsSource="{Binding DirectUploadPreflightIssues}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  Margin="0,4,0,0"
                                  MinHeight="160">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="140" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                                <DataGridTextColumn Header="Relative Path" Binding="{Binding RelativePath}" Width="220" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#E4E7EB" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Profiling Validation" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{Binding ValidationErrorCountDisplay, StringFormat=Errors: {0}}" Foreground="#B42318" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ValidationWarningCountDisplay, StringFormat=Warnings: {0}}" Foreground="#B45309" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ValidationInfoCountDisplay, StringFormat=Info: {0}}" Foreground="#555555" />
                        </StackPanel>
                        <TextBlock Text="Validating..." Foreground="#555555" Margin="0,0,0,6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReviewScopeValidationBusy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListView ItemsSource="{Binding ProfilingValidationIssues}" Height="170">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Severity" Width="70" DisplayMemberBinding="{Binding SeverityDisplay}" />
                                    <GridViewColumn Header="Scope" Width="55" DisplayMemberBinding="{Binding ScopeDisplay}" />
                                    <GridViewColumn Header="Target" Width="95" DisplayMemberBinding="{Binding Target}" />
                                    <GridViewColumn Header="Message" Width="250" DisplayMemberBinding="{Binding Message}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </Border>

                <StackPanel Visibility="Collapsed">
                    <TextBlock Text="Details" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding SelectedFolderRelativePath}" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedFolderPath}" Foreground="#666666" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <TextBlock Text="This folder will not be created in NetDocuments via ndImport."
                               Foreground="#B45309"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Visibility="{Binding SelectedFolderIsEffectivelyEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                        <TextBlock Text="{Binding SelectedFolderFilesDisplay, StringFormat=Total files: {0}}" />
                        <TextBlock Text="{Binding SelectedFolderBytesDisplay, StringFormat=Total bytes: {0}}" />
                        <TextBlock Text="{Binding SelectedFolderLargeFilesDisplay, StringFormat=Large files: {0}}" />
                        <TextBlock Text="{Binding SelectedFolderExcludedDisplay, StringFormat=Excluded folders: {0}}" />
                    </StackPanel>

                    <TextBlock Text="Folder selection" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Width="110" Margin="0,0,6,0" Click="OnSetImportInherit" Style="{StaticResource SecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="?" Foreground="#888888" Margin="0,0,6,0" />
                                <TextBlock Text="Inherit" />
                            </StackPanel>
                        </Button>
                        <Button Width="110" Margin="0,0,6,0" Click="OnSetImportInclude" Style="{StaticResource SecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="12" Height="12" Fill="#2E7D32" Data="M2,6 L5,9 L10,2" Stroke="#2E7D32" StrokeThickness="2" Margin="0,0,6,0" />
                                <TextBlock Text="Include" />
                            </StackPanel>
                        </Button>
                        <Button Width="110" Click="OnSetImportExclude" Style="{StaticResource SecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="12" Height="12" Stroke="#C62828" StrokeThickness="2" Data="M2,2 L10,10 M10,2 L2,10" Margin="0,0,6,0" />
                                <TextBlock Text="Exclude" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Content="Apply to children" Width="140" Margin="0,0,0,6" Click="OnApplyImportToChildren" Style="{StaticResource SecondaryButton}" />
                    <TextBlock Text="{Binding SelectedImportMode, StringFormat=Selected mode: {0}}" Foreground="#555555" />
                    <TextBlock Text="{Binding SelectedEffectiveImportMode, StringFormat=Effective mode: {0}}" Foreground="#555555" Margin="0,0,0,10" />

                    <TextBlock Text="File selection" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Width="110" Margin="0,0,6,0" Click="OnSetFileInclude" Style="{StaticResource SecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="12" Height="12" Fill="#2E7D32" Data="M2,6 L5,9 L10,2" Stroke="#2E7D32" StrokeThickness="2" Margin="0,0,6,0" />
                                <TextBlock Text="Include" />
                            </StackPanel>
                        </Button>
                        <Button Width="110" Margin="0,0,6,0" Click="OnSetFileExclude" Style="{StaticResource SecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="12" Height="12" Stroke="#C62828" StrokeThickness="2" Data="M2,2 L10,10 M10,2 L2,10" Margin="0,0,6,0" />
                                <TextBlock Text="Exclude" />
                            </StackPanel>
                        </Button>
                        <Button Width="110" Click="OnClearFileOverride" Style="{StaticResource SecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="?" Foreground="#888888" Margin="0,0,6,0" />
                                <TextBlock Text="Clear" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
