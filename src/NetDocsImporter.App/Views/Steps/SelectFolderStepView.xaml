<UserControl x:Class="NetDocsImporter.App.Views.Steps.SelectFolderStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NetDocsImporter.App"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
        <TextBlock Text="NetDocuments Upload Target" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="Login and choose your NetDocuments location to pre-fill profiling attributes."
                   Foreground="#555555" Margin="0,0,0,8" TextWrapping="Wrap" />

        <Border BorderBrush="#E4E7EB" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="1) NetDocuments Connection" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="Region" Foreground="#555555" />
                <ComboBox ItemsSource="{Binding NetDocumentsRegions}"
                          SelectedItem="{Binding SelectedNetDocumentsRegion}"
                          Margin="0,2,0,6" />
                <Border BorderBrush="#EEF1F5" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{Binding NetDocumentsConnectionProfileStatus}" Foreground="#555555" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="#E4E7EB"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        Margin="0,0,0,8"
                        Visibility="{Binding CanShowNetDocumentsDevBootstrap, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Developer mode only: local OAuth bootstrap (not for distribution)."
                                   Foreground="#8A5A00"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Client Id" Foreground="#555555" />
                        <TextBox Text="{Binding NetDocumentsBootstrapClientId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                        <TextBlock Text="Client Secret" Foreground="#555555" />
                        <PasswordBox Margin="0,2,0,6"
                                     Loaded="OnNetDocumentsBootstrapClientSecretLoaded"
                                     PasswordChanged="OnNetDocumentsBootstrapClientSecretPasswordChanged" />
                        <TextBlock Text="Redirect URI" Foreground="#555555" />
                        <TextBox Text="{Binding NetDocumentsBootstrapRedirectUri, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                        <Button Content="Save Local OAuth Profile"
                                Width="180"
                                Click="OnSaveNetDocumentsOAuthProfile"
                                IsEnabled="{Binding CanSaveNetDocumentsDevBootstrap}"
                                Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Connect"
                            Width="110"
                            Margin="0,0,6,0"
                            Click="OnConnectToNetDocuments"
                            IsEnabled="{Binding CanConnectToNetDocuments}"
                            Style="{StaticResource PrimaryButton}" />
                    <Button Content="Sync Cabinets"
                            Width="120"
                            Margin="0,0,6,0"
                            Click="OnSyncNetDocumentsCabinets"
                            IsEnabled="{Binding CanSyncNetDocumentsCabinets}"
                            Style="{StaticResource SecondaryButton}" />
                </StackPanel>
                <TextBlock Text="{Binding NetDocumentsConnectedUser, StringFormat=Connected user: {0}}" Foreground="#555555" />
            </StackPanel>
        </Border>

        <Border BorderBrush="#E4E7EB" BorderThickness="1" CornerRadius="4" Padding="10">
            <StackPanel>
                <TextBlock Text="2) Select NetDocuments Upload Destination" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="Repository" Foreground="#555555" />
                <ComboBox ItemsSource="{Binding NetDocumentsRepositories}"
                          SelectedValuePath="RepositoryId"
                          DisplayMemberPath="RepositoryName"
                          SelectedValue="{Binding SelectedNetDocumentsRepositoryId, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,2,0,6"
                          IsEnabled="{Binding IsNetDocumentsConnected}" />
                <TextBlock Text="Cabinet" Foreground="#555555" />
                <ComboBox ItemsSource="{Binding NetDocumentsCabinets}"
                          SelectedValuePath="CabinetId"
                          DisplayMemberPath="CabinetName"
                          SelectedValue="{Binding SelectedNetDocumentsCabinetId, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,2,0,6"
                          IsEnabled="{Binding IsNetDocumentsConnected}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Force Refresh"
                            Width="120"
                            Margin="0,0,6,0"
                            Click="OnLoadTargetContainers"
                            IsEnabled="{Binding CanPickNetDocumentsTarget}"
                            Style="{StaticResource SecondaryButton}" />
                </StackPanel>

                <TabControl Margin="0,4,0,8"
                            SelectionChanged="OnTargetBrowserTabSelectionChanged">
                    <TabItem Header="Recent">
                        <StackPanel Margin="4">
                            <TextBlock Text="Loading recent workspaces..."
                                       Foreground="#555555"
                                       Margin="0,0,0,6"
                                       Visibility="{Binding IsLoadingRecentTargets, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ListView ItemsSource="{Binding RecentTargets}"
                                      SelectedItem="{Binding SelectedRecentTarget}"
                                      Height="150">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Name" Width="170" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="Type" Width="120" DisplayMemberBinding="{Binding TypeDisplay}" />
                                        <GridViewColumn Header="When" Width="130" DisplayMemberBinding="{Binding TimestampDisplay}" />
                                        <GridViewColumn Header="Source" Width="80" DisplayMemberBinding="{Binding SourceDisplay}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Favorites">
                        <StackPanel Margin="4">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="Toggle Favorite" Width="120" Click="OnToggleFavoriteForSelectedTarget" Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                            <TextBlock Text="Loading favorite workspaces..."
                                       Foreground="#555555"
                                       Margin="0,0,0,6"
                                       Visibility="{Binding IsLoadingFavoriteTargets, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ListView ItemsSource="{Binding FavoriteTargets}"
                                      SelectedItem="{Binding SelectedFavoriteTarget}"
                                      Height="150">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Name" Width="170" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="Type" Width="120" DisplayMemberBinding="{Binding TypeDisplay}" />
                                        <GridViewColumn Header="When" Width="130" DisplayMemberBinding="{Binding TimestampDisplay}" />
                                        <GridViewColumn Header="Source" Width="80" DisplayMemberBinding="{Binding SourceDisplay}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Go to Workspace">
                        <StackPanel Margin="4">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBox Width="260"
                                         Margin="0,0,6,0"
                                         Text="{Binding WorkspaceSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanSearchWorkspaceTargets}" />
                                <Button Content="Search"
                                        Width="100"
                                        Margin="0,0,6,0"
                                        Click="OnSearchWorkspaceTargets"
                                        IsEnabled="{Binding CanSearchWorkspaceTargets}"
                                        Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                            <ListView ItemsSource="{Binding WorkspaceSearchTargets}"
                                      SelectedItem="{Binding SelectedWorkspaceSearchTarget}"
                                      Height="235"
                                      Margin="0,0,0,6">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Workspace" Width="170" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding TypeDisplay}" />
                                        <GridViewColumn Header="Parent Key" Width="90" DisplayMemberBinding="{Binding ParentKey}" />
                                        <GridViewColumn Header="Parent Name" Width="160" DisplayMemberBinding="{Binding ParentDescription}" />
                                        <GridViewColumn Header="Child Key" Width="90" DisplayMemberBinding="{Binding ChildKey}" />
                                        <GridViewColumn Header="Child Name" Width="160" DisplayMemberBinding="{Binding ChildDescription}" />
                                        <GridViewColumn Header="Path" Width="240" DisplayMemberBinding="{Binding PathDisplay}" />
                                        <GridViewColumn Header="Source" Width="70" DisplayMemberBinding="{Binding Source}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock Text="{Binding WorkspaceLookupStatus}" Foreground="#555555" Margin="0,0,0,4" TextWrapping="Wrap" />
                        </StackPanel>
                    </TabItem>

                </TabControl>

                <Border BorderBrush="#E4E7EB" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Selected Target" FontWeight="Bold" FontSize="16" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding SelectedNetDocumentsTargetName, StringFormat=Name: {0}}" Foreground="#333333" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedNetDocumentsTargetTypeDisplay, StringFormat=Type: {0}}" Foreground="#333333" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedNetDocumentsTargetId, StringFormat=Id: {0}}" Foreground="#333333" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedNetDocumentsTargetPath, StringFormat=Path: {0}}" Foreground="#333333" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TargetBrowserMessage}" Foreground="#555555" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding TargetProfileMetadataStatus}" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,8" />

            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
