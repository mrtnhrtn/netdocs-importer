<UserControl x:Class="NetDocsImporter.App.Views.Steps.SelectFolderStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NetDocsImporter.App"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="NetDocuments Upload Target" Style="{StaticResource SectionTitle}" />
        <TextBlock Grid.Row="1"
                   Text="Choose your NetDocuments upload destination. Connection and sign-in are managed in Settings (gear icon)."
                   Foreground="#555555"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap" />

        <Border Grid.Row="2" BorderBrush="#E4E7EB" BorderThickness="1" CornerRadius="4" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="1) Select NetDocuments Upload Destination" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Repository" Foreground="#555555" />
                            <ComboBox ItemsSource="{Binding NetDocumentsRepositories}"
                                      SelectedValuePath="RepositoryId"
                                      DisplayMemberPath="RepositoryName"
                                      SelectedValue="{Binding SelectedNetDocumentsRepositoryId, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,2,0,0"
                                      MinWidth="240"
                                      MaxWidth="520"
                                      HorizontalAlignment="Left"
                                      IsEnabled="{Binding IsNetDocumentsConnected}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cabinet" Foreground="#555555" />
                            <ComboBox ItemsSource="{Binding NetDocumentsCabinets}"
                                      SelectedValuePath="CabinetId"
                                      DisplayMemberPath="CabinetName"
                                      SelectedValue="{Binding SelectedNetDocumentsCabinetId, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,2,0,0"
                                      MinWidth="240"
                                      MaxWidth="520"
                                      HorizontalAlignment="Left"
                                      IsEnabled="{Binding IsNetDocumentsConnected}" />
                        </StackPanel>
                        <Button Grid.Column="4"
                                Content="Force Refresh"
                                Width="120"
                                VerticalAlignment="Bottom"
                                Click="OnLoadTargetContainers"
                                IsEnabled="{Binding CanPickNetDocumentsTarget}"
                                Style="{StaticResource SecondaryButton}" />
                    </Grid>
                </StackPanel>

                <TabControl Grid.Row="1"
                            Margin="0,4,0,0"
                            BorderThickness="0"
                            Background="Transparent"
                            SelectedIndex="{Binding SelectedTargetBrowserTabIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid KeyboardNavigation.TabNavigation="Local">
                                <TabPanel IsItemsHost="True" Background="Transparent" />
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabItem Header="Recent" />
                    <TabItem Header="Favorites" />
                    <TabItem Header="Go to Workspace" />
                </TabControl>

                <Border Grid.Row="2" BorderBrush="#E4E7EB" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Workspace / Folder / Filter Tree" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="1"
                                   Text="Loading recent workspaces..."
                                   Foreground="#555555"
                                   Margin="0,0,0,6"
                                   Visibility="{Binding IsLoadingRecentTargets, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Grid.Row="2"
                                   Text="Loading favorite workspaces..."
                                   Foreground="#555555"
                                   Margin="0,0,0,6"
                                   Visibility="{Binding IsLoadingFavoriteTargets, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBox Width="260"
                                     Margin="0,0,6,0"
                                     Text="{Binding WorkspaceSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanSearchWorkspaceTargets}" />
                            <Button Content="Search"
                                    Width="100"
                                    Margin="0,0,6,0"
                                    Click="OnSearchWorkspaceTargets"
                                    IsEnabled="{Binding CanSearchWorkspaceTargets}"
                                    Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                        <TextBlock Grid.Row="4"
                                   Text="{Binding WorkspaceLookupStatus}"
                                   Foreground="#555555"
                                   Margin="0,0,0,6"
                                   TextWrapping="Wrap" />
                        <TreeView Grid.Row="5"
                                  ItemsSource="{Binding BrowseRootNodes}"
                                  MinHeight="340"
                                  SelectedItemChanged="OnBrowseSelectionChanged">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <EventSetter Event="Expanded" Handler="OnBrowseNodeExpanded" />
                                    <Setter Property="Foreground" Value="#1F2933" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="{Binding IconGlyph}"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{Binding IconColorHex}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1F2933" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Metadata}" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#666666" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                                                <Setter Property="Foreground" Value="#E5EDFF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="3" Text="{Binding TargetBrowserMessage}" Foreground="#555555" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap" />
                <TextBlock Grid.Row="4" Text="{Binding TargetProfileMetadataStatus}" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,8" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
