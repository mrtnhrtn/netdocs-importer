<UserControl x:Class="NetDocsImporter.App.Views.Steps.SelectFolderStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NetDocsImporter.App"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
        <TextBlock Text="NetDocuments Upload Target" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="Choose your NetDocuments upload destination. Connection and sign-in are managed in Settings (gear icon)."
                   Foreground="#555555" Margin="0,0,0,8" TextWrapping="Wrap" />

        <Border BorderBrush="#E4E7EB" BorderThickness="1" CornerRadius="4" Padding="10">
            <StackPanel>
                <TextBlock Text="1) Select NetDocuments Upload Destination" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="Repository" Foreground="#555555" />
                <ComboBox ItemsSource="{Binding NetDocumentsRepositories}"
                          SelectedValuePath="RepositoryId"
                          DisplayMemberPath="RepositoryName"
                          SelectedValue="{Binding SelectedNetDocumentsRepositoryId, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,2,0,6"
                          IsEnabled="{Binding IsNetDocumentsConnected}" />
                <TextBlock Text="Cabinet" Foreground="#555555" />
                <ComboBox ItemsSource="{Binding NetDocumentsCabinets}"
                          SelectedValuePath="CabinetId"
                          DisplayMemberPath="CabinetName"
                          SelectedValue="{Binding SelectedNetDocumentsCabinetId, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,2,0,6"
                          IsEnabled="{Binding IsNetDocumentsConnected}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Force Refresh"
                            Width="120"
                            Margin="0,0,6,0"
                            Click="OnLoadTargetContainers"
                            IsEnabled="{Binding CanPickNetDocumentsTarget}"
                            Style="{StaticResource SecondaryButton}" />
                </StackPanel>

                <TabControl Margin="0,4,0,8"
                            SelectedIndex="{Binding SelectedTargetBrowserTabIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TabItem Header="Recent">
                        <StackPanel Margin="4">
                            <TextBlock Text="Loading recent workspaces..."
                                       Foreground="#555555"
                                       Margin="0,0,0,6"
                                       Visibility="{Binding IsLoadingRecentTargets, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="Recent targets are shown in the tree below."
                                       Foreground="#555555"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Favorites">
                        <StackPanel Margin="4">
                            <TextBlock Text="Loading favorite workspaces..."
                                       Foreground="#555555"
                                       Margin="0,0,0,6"
                                       Visibility="{Binding IsLoadingFavoriteTargets, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="Favorite targets are shown in the tree below."
                                       Foreground="#555555"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Go to Workspace">
                        <StackPanel Margin="4">
                            <TextBlock Text="Use the search controls in the tree panel to load workspace results."
                                       Foreground="#555555"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </TabItem>

                </TabControl>

                <Border BorderBrush="#E4E7EB" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Workspace / Folder / Filter Tree" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBox Width="260"
                                     Margin="0,0,6,0"
                                     Text="{Binding WorkspaceSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanSearchWorkspaceTargets}" />
                            <Button Content="Search"
                                    Width="100"
                                    Margin="0,0,6,0"
                                    Click="OnSearchWorkspaceTargets"
                                    IsEnabled="{Binding CanSearchWorkspaceTargets}"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button Content="Toggle Favorite"
                                    Width="120"
                                    Click="OnToggleFavoriteForSelectedTarget"
                                    IsEnabled="{Binding CanPickNetDocumentsTarget}"
                                    Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                        <TextBlock Text="{Binding WorkspaceLookupStatus}"
                                   Foreground="#555555"
                                   Margin="0,0,0,6"
                                   TextWrapping="Wrap" />
                        <TreeView ItemsSource="{Binding BrowseRootNodes}"
                                  Height="220"
                                  SelectedItemChanged="OnBrowseSelectionChanged">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <EventSetter Event="Expanded" Handler="OnBrowseNodeExpanded" />
                                    <Setter Property="Foreground" Value="#1F2933" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="{Binding IconGlyph}"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{Binding IconColorHex}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1F2933" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Metadata}" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#666666" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                                                <Setter Property="Foreground" Value="#E5EDFF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <TextBlock Text="Expand cabinet/workspace/folder nodes to lazy-load child folders and filters."
                                   Foreground="#666666"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border BorderBrush="#E4E7EB" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Selected Target" FontWeight="Bold" FontSize="16" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding SelectedNetDocumentsTargetName, StringFormat=Name: {0}}" Foreground="#333333" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedNetDocumentsTargetTypeDisplay, StringFormat=Type: {0}}" Foreground="#333333" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedNetDocumentsTargetId, StringFormat=Id: {0}}" Foreground="#333333" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedNetDocumentsTargetPath, StringFormat=Path: {0}}" Foreground="#333333" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TargetBrowserMessage}" Foreground="#555555" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding TargetProfileMetadataStatus}" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,8" />

            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
