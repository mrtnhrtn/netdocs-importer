<Window x:Class="NetDocsImporter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NetDocsImporter.App"
        xmlns:core="clr-namespace:NetDocsImporter.Core;assembly=NetDocsImporter.Core"
        mc:Ignorable="d"
        Title="NetDocs Importer" Height="620" Width="1100" MinHeight="520" MinWidth="980">
    <Window.Resources>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <HierarchicalDataTemplate DataType="{x:Type core:FolderNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Path Width="14" Height="12" Margin="0,0,4,0" Fill="#F4C542" Stroke="#C89200"
                      Data="M1,4 L9,4 L11,6 L21,6 L21,17 L1,17 Z" />
                <TextBlock Text="{Binding Name}" Margin="0,0,6,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#222222" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EffectiveIncluded}" Value="False">
                                    <Setter Property="Foreground" Value="#888888" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Margin="0,0,6,0" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Y" />
                            <Setter Property="Foreground" Value="#2E7D32" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EffectiveIncluded}" Value="False">
                                    <Setter Property="Text" Value="N" />
                                    <Setter Property="Foreground" Value="#888888" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="(inherited)" FontStyle="Italic" Foreground="#777777">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOverride}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type core:FileNodeViewModel}">
            <StackPanel Orientation="Horizontal">
                <Path Width="12" Height="14" Margin="2,0,6,0" Fill="#E0E0E0" Stroke="#999999"
                      Data="M2,1 L10,1 L14,5 L14,18 L2,18 Z M10,1 L10,5 L14,5" />
                <TextBlock Text="{Binding Name}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#333333" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EffectiveIncluded}" Value="False">
                                    <Setter Property="Foreground" Value="#AAAAAA" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="Folder Tree" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TreeView ItemsSource="{Binding FolderRoots}"
                      SelectedItemChanged="OnFolderTreeSelectedItemChanged"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      BorderThickness="1" BorderBrush="#CCD0D5">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <EventSetter Event="Expanded" Handler="OnFolderTreeExpanded" />
                        <EventSetter Event="Collapsed" Handler="OnFolderTreeCollapsed" />
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </StackPanel>

        <Grid Grid.Column="1" Margin="0,0,12,0">
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="0">
                <Button Content="Select Folder" Width="130" Margin="0,0,8,0" Click="OnSelectFolder"
                        IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}}" />
                <Button Content="Cancel" Width="90" Click="OnCancelScan"
                        IsEnabled="{Binding IsScanning}"
                        Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <TextBlock Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap">
                <Run Text="Selected folder: " />
                <Run Text="{Binding SelectedFolder, TargetNullValue=No folder selected., Mode=OneWay}" />
            </TextBlock>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Files scanned: " />
                <TextBlock Text="{Binding TotalFilesDisplay}" FontWeight="SemiBold" Margin="0,0,16,0" />
                <TextBlock Text="Total bytes: " />
                <TextBlock Text="{Binding TotalBytesDisplay}" FontWeight="SemiBold" />
            </StackPanel>

            <TextBlock Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap">
                <Run Text="Current job: " />
                <Run Text="{Binding CurrentJobId, TargetNullValue=No active job., Mode=OneWay}" />
            </TextBlock>

            <TextBlock Grid.Row="4" Margin="0,12,0,4" Foreground="DarkOrange" FontWeight="SemiBold"
                       Text="Large files (> 1.8 GB) require attention." />

            <ListView Grid.Row="5" ItemsSource="{Binding LargeFiles}" BorderThickness="1" BorderBrush="#CCD0D5">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Path" Width="420" DisplayMemberBinding="{Binding Path}" />
                        <GridViewColumn Header="Size" Width="120" DisplayMemberBinding="{Binding SizeDisplay}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <TextBlock Grid.Row="6" Margin="0,10,0,0" Text="{Binding StatusText}" Foreground="#444444" />
        </Grid>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,0">
                <TextBlock Text="Selected Folder" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedFolderPath}" Margin="0,4,0,8" TextWrapping="Wrap" />

                <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                    <TextBlock Text="{Binding SelectedFolderFilesDisplay, StringFormat=Total files: {0}}" />
                    <TextBlock Text="{Binding SelectedFolderBytesDisplay, StringFormat=Total bytes: {0}}" />
                    <TextBlock Text="{Binding SelectedFolderLargeFilesDisplay, StringFormat=Large files: {0}}" />
                    <TextBlock Text="{Binding SelectedFolderExcludedDisplay, StringFormat=Excluded folders: {0}}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Exclude this folder" Width="130" Margin="0,0,6,0" Click="OnExcludeFolder" />
                    <Button Content="Include this folder" Width="130" Margin="0,0,6,0" Click="OnIncludeFolder" />
                    <Button Content="Clear override" Width="110" Click="OnClearFolderOverride" />
                </StackPanel>

                <TextBlock Text="Import Selection" FontWeight="SemiBold" />
                <StackPanel Orientation="Vertical" Margin="0,4,0,12">
                    <TextBlock Text="{Binding IncludedFilesCountDisplay, StringFormat=Included files: {0}}" />
                    <TextBlock Text="{Binding ExcludedFilesCountDisplay, StringFormat=Excluded files: {0}}" />
                </StackPanel>

                <TextBlock Text="Recent Jobs" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                    <Button Content="Load Recent" Width="110" Click="OnLoadRecentJobs" />
                </StackPanel>
                <ListView ItemsSource="{Binding RecentJobs}"
                          SelectedItem="{Binding SelectedRecentJob, Mode=TwoWay}"
                          BorderThickness="1" BorderBrush="#CCD0D5" Height="150">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Job" Width="70" DisplayMemberBinding="{Binding JobIdShort}" />
                            <GridViewColumn Header="Created" Width="110" DisplayMemberBinding="{Binding CreatedDisplay}" />
                            <GridViewColumn Header="Status" Width="90" DisplayMemberBinding="{Binding Status}" />
                            <GridViewColumn Header="Files" Width="70" DisplayMemberBinding="{Binding FileCountDisplay}" />
                            <GridViewColumn Header="Bytes" Width="90" DisplayMemberBinding="{Binding TotalBytesDisplay}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock Text="Import Settings" FontWeight="SemiBold" Margin="0,12,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Max Concurrency:" VerticalAlignment="Center" />
                    <TextBox Width="60" Margin="8,0,0,0" Text="{Binding MaxConcurrency, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Delay ms between starts:" VerticalAlignment="Center" />
                    <TextBox Width="60" Margin="8,0,0,0" Text="{Binding DelayMsBetweenStarts, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <Button Content="Start Import" Width="100" Margin="0,0,6,0" Click="OnStartImport"
                            IsEnabled="{Binding CanStartImport}" />
                    <Button Content="Pause" Width="70" Margin="0,0,6,0" Click="OnPauseImport"
                            IsEnabled="{Binding CanPauseImport}" />
                    <Button Content="Resume" Width="70" Margin="0,0,6,0" Click="OnResumeImport"
                            IsEnabled="{Binding CanResumeImport}" />
                    <Button Content="Cancel" Width="70" Click="OnCancelImport"
                            IsEnabled="{Binding CanCancelImport}" />
                </StackPanel>

                <TextBlock Text="Import Progress" FontWeight="SemiBold" />
                <StackPanel Orientation="Vertical" Margin="0,6,0,8">
                    <TextBlock Text="{Binding ImportTotalFilesDisplay, StringFormat=Total files: {0}}" />
                    <TextBlock Text="{Binding ImportQueuedDisplay, StringFormat=Queued: {0}}" />
                    <TextBlock Text="{Binding ImportRunningDisplay, StringFormat=Running: {0}}" />
                    <TextBlock Text="{Binding ImportSucceededDisplay, StringFormat=Succeeded: {0}}" />
                    <TextBlock Text="{Binding ImportFailedDisplay, StringFormat=Failed: {0}}" />
                    <TextBlock Text="{Binding ImportCanceledDisplay, StringFormat=Canceled: {0}}" />
                </StackPanel>

                <TextBlock Text="Latest Transfers" FontWeight="SemiBold" Margin="0,6,0,4" />
                <ListView ItemsSource="{Binding LatestTransfers}" BorderThickness="1" BorderBrush="#CCD0D5" Height="180">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Path" Width="170" DisplayMemberBinding="{Binding RelativePath}" />
                            <GridViewColumn Header="Status" Width="80" DisplayMemberBinding="{Binding Status}" />
                            <GridViewColumn Header="Attempt" Width="60" DisplayMemberBinding="{Binding Attempt}" />
                            <GridViewColumn Header="Duration" Width="80" DisplayMemberBinding="{Binding DurationDisplay}" />
                            <GridViewColumn Header="Error" Width="180" DisplayMemberBinding="{Binding Error}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
